# ---------------------------------------------------------------------------
# Swift Consultancy — environment variables
# Copy to .env.local for development, and set the same keys in Vercel.
# ---------------------------------------------------------------------------

# Email delivery (Resend) --------------------------------------------------
# Without these the consultation form runs in demo mode locally, and fails
# closed in production with a "please email us directly" message.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain, e.g. "Swift Consultancy <hello@swiftconsultancy.us>"
CONSULTATION_FROM=
# Where enquiries are delivered. Defaults to the address in src/lib/site.ts.
CONSULTATION_INBOX=

# Spam protection (Cloudflare Turnstile) -----------------------------------
# Both keys come from the Cloudflare dashboard. When the site key is absent the
# widget is not rendered; when the secret is absent in production the server
# action rejects submissions rather than accepting unverified traffic.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Scheduling (optional, Cal.com) -------------------------------------------
# Your Cal.com event path, e.g. "swift-consultancy/free-consultation".
# When set, the contact page offers a booking calendar beside the form.
NEXT_PUBLIC_CAL_LINK=
