# ---------------------------------------------------------------------------
# Swift Consultancy — environment variables
# Copy to .env.local for development, and set the same keys in Vercel.
# ---------------------------------------------------------------------------

# Email delivery (Resend) --------------------------------------------------
# Without these the consultation form runs in demo mode locally, and fails
# closed in production with a "please email us directly" message.
# A "Sending access" key is enough (and safest) for the site.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain, e.g. "Swift Consultancy <hello@swiftconsultancy.us>"
CONSULTATION_FROM=
# Where enquiries are delivered. Defaults to team@swiftconsultancy.us.
CONSULTATION_INBOX=

# Spam protection (Cloudflare Turnstile) -----------------------------------
# Both keys come from the Cloudflare dashboard. With neither set, Turnstile is
# off and the honeypot alone guards the forms. With only the site key set, the
# widget renders but nothing can verify it, so submissions are rejected.
# Set both to switch it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Swift Agent (AI chat assistant) -------------------------------------------
# Free API key from https://console.groq.com (no credit card). Without it the
# chat window still opens but offers WhatsApp and email instead of AI replies.
GROQ_API_KEY=
# Optional: a different Groq model id. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Search engine verification (optional) -----------------------------------
# Tokens from Google Search Console ("HTML tag" method — the content value
# only) and Bing Webmaster Tools. Each emits its meta tag only when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Scheduling (optional, Cal.com) -------------------------------------------
# Your Cal.com event path, e.g. "swift-consultancy/free-consultation".
# When set, the contact page offers a booking calendar beside the form.
NEXT_PUBLIC_CAL_LINK=
